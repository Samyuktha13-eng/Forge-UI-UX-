{
  "version": 2,
  "builds": [
    { "src": "backend/api/*.js", "use": "@vercel/node" },
    { "src": "frontend/*.html", "use": "@vercel/static" },
    { "src": "frontend/*.css", "use": "@vercel/static" },
    { "src": "frontend/*.js", "use": "@vercel/static" },
    { "src": "frontend/assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/frontend/assets/$1" },
    { "src": "/api/(.*)", "dest": "/backend/api/$1.js" },
    { "src": "/about", "dest": "/frontend/about.html" },
    { "src": "/podcasts", "dest": "/frontend/podcasts.html" },
    { "src": "/contact", "dest": "/frontend/contact.html" },
    { "src": "/", "dest": "/frontend/index.html" },
    { "src": "/(.*\\.html)", "dest": "/frontend/$1" },
    { "src": "/(.*\\.css)", "dest": "/frontend/$1" },
    { "src": "/script\\.js", "dest": "/frontend/script.js" },
    { "src": "/styles\\.css", "dest": "/frontend/styles.css" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
